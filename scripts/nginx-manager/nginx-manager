#!/bin/bash

# 🚀 Nginx Manager 智能启动器
# 自动检测系统并选择最合适的版本

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# 获取脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 显示欢迎信息
show_welcome() {
    cat << EOF
${WHITE}🚀 Nginx Manager 智能启动器${NC}

${CYAN}检测到的系统信息:${NC}
$(printf "%-20s %s\n" "🖥️  操作系统:" "$(uname -s)")
$(printf "%-20s %s\n" "🏗️  架构:" "$(uname -m)")
$(printf "%-20s %s\n" "🔧  Shell:" "$SHELL")

EOF
}

# 检测系统并推荐版本
detect_and_recommend() {
    local os_type="$(uname -s)"
    local recommended_number=""
    local description=""
    
    case "$os_type" in
        Darwin)
            if command -v brew >/dev/null 2>&1; then
                recommended_number=2
                description="🍎 macOS (Homebrew 优化版本)"
            else
                recommended_number=1
                description="🌐 通用版本 (macOS 无 Homebrew)"
            fi
            ;;
        Linux)
            if [ -f /etc/os-release ]; then
                . /etc/os-release
                recommended_number=3
                description="🐧 Linux ($NAME 优化版本)"
            else
                recommended_number=1
                description="🌐 通用版本 (Linux 发行版未知)"
            fi
            ;;
        *)
            recommended_number=1
            description="🌐 通用版本 (未知系统)"
            ;;
    esac
    
    # 设置全局变量
    RECOMMENDED_CHOICE="$recommended_number"
    
    echo -e "${GREEN}📋 推荐版本: ${WHITE}选项 $recommended_number${NC}"
    echo -e "${BLUE}📝 说明: $description${NC}"
    echo
}

# 显示所有可用版本
show_available_versions() {
    echo -e "${CYAN}📚 可用版本:${NC}"
    echo
    
    local versions=(
        "nginx-manager.sh:🌐 通用版本:支持 Linux/macOS，自动兼容处理"
        "nginx-manager-macos.sh:🍎 macOS 专版:Homebrew 路径优化，macOS 特性"
        "nginx-manager-linux.sh:🐧 Linux 专版:多发行版支持，systemd 集成"
    )
    
    for i in "${!versions[@]}"; do
        local version_info=(${versions[$i]//:/ })
        local script="${version_info[0]}"
        local icon="${version_info[1]}"
        local desc="${version_info[2]}"
        
        if [ -f "$SCRIPT_DIR/$script" ]; then
            printf "${WHITE}%d.${NC} %-30s %s %s\n" "$((i+1))" "$script" "$icon" "$desc"
        else
            printf "${RED}%d.${NC} %-30s %s %s ${RED}(不存在)${NC}\n" "$((i+1))" "$script" "$icon" "$desc"
        fi
    done
    echo
}

# 交互式选择
interactive_select() {
    echo -e "${YELLOW}请选择要运行的版本 (回车使用推荐版本):${NC}"
    read -p "输入数字 (1-3) 或直接回车: " choice
    
    case "$choice" in
        1)
            return 1
            ;;
        2)
            return 2
            ;;
        3)
            return 3
            ;;
        "")
            return "$RECOMMENDED_CHOICE"
            ;;
        *)
            echo -e "${RED}❌ 无效选择，使用推荐版本${NC}"
            return "$RECOMMENDED_CHOICE"
            ;;
    esac
}

# 运行选定的脚本
run_script() {
    local choice=$1
    shift  # 移除第一个参数，剩下的传给脚本
    
    local scripts=("nginx-manager.sh" "nginx-manager-macos.sh" "nginx-manager-linux.sh")
    local selected_script="${scripts[$((choice-1))]}"
    local script_path="$SCRIPT_DIR/$selected_script"
    
    echo -e "${BLUE}🚀 启动: $selected_script${NC}"
    echo -e "${CYAN}📍 路径: $script_path${NC}"
    echo
    
    if [ -f "$script_path" ]; then
        if [ -x "$script_path" ]; then
            exec "$script_path" "$@"
        else
            echo -e "${YELLOW}⚠️ 脚本不可执行，尝试添加执行权限...${NC}"
            chmod +x "$script_path" 2>/dev/null
            if [ $? -eq 0 ]; then
                exec "$script_path" "$@"
            else
                echo -e "${RED}❌ 无法添加执行权限，使用 bash 运行${NC}"
                exec bash "$script_path" "$@"
            fi
        fi
    else
        echo -e "${RED}❌ 脚本文件不存在: $script_path${NC}"
        echo -e "${BLUE}💡 请确保所有脚本文件都在当前目录中${NC}"
        exit 1
    fi
}

# 主函数
main() {
    # 如果传入了参数且第一个参数是脚本选择，则直接运行
    if [[ "$1" =~ ^(1|2|3|macos|linux|universal)$ ]]; then
        case "$1" in
            1|universal) choice=1 ;;
            2|macos) choice=2 ;;
            3|linux) choice=3 ;;
        esac
        shift
        run_script "$choice" "$@"
        return
    fi
    
    # 显示信息
    show_welcome
    detect_and_recommend
    show_available_versions
    
    # 交互式选择
    interactive_select
    local choice=$?
    
    # 运行选定的脚本
    run_script "$choice" "$@"
}

# 执行主函数
main "$@"
